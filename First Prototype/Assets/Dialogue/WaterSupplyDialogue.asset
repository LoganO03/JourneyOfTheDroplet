  m_Script: {fileID: 11500000, guid: b9300cdd1a21ad44ba3fb44ddb8e9e37, type: 3}
  m_Name: WaterSupplyDialogue
  m_EditorClassIdentifier: 
  dialogue:
  - Over 96% of the water on the Earth's surface is saline water in the ocean.
  - Most fresh water is underground or in glaciers.
  - Only a tiny fraction of fresh water can be found as vapor in the air or on the
    surface in streams, lakes, and wetlands.
