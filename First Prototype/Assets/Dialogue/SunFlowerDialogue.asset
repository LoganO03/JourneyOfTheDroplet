  m_Script: {fileID: 11500000, guid: b9300cdd1a21ad44ba3fb44ddb8e9e37, type: 3}
  m_Name: SunFlowerDialogue
  m_EditorClassIdentifier: 
  dialogue:
  - 'Hi! '
  - I just love sunlight and water!
  - I use sunlight and water for photosynthesis, to make food so I can survive and
    grow!
  - That mushroom up ahead looks bouncy. If you give it some water, it might help
    you jump really high!
  - See ya!
